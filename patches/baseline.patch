+# 模态消融开关：MMD_DROP_MODALITIES="infrared,depth" 时，被丢弃的模态直接喂全零通道。
+# 通道数仍是 7，网络结构不变，因此这是"信息消融"——测的是这三个模态各自提供了多少信息，
+# 而不是架构差异。被丢弃的模态连读盘都省掉，消融跑起来更快。
+_DROP_MODALITIES = {
+    m.strip().lower() for m in os.environ.get("MMD_DROP_MODALITIES", "").split(",") if m.strip()
+}
+
 
